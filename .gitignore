# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
secrets.json
credentials.json
service-account*.json
.netrc
.npmrc
*.crt

# Database dumps can contain conversation content; keep them out of the repo.
*.dump
*.sql.gz

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/
*.local

# --- Data & build artifacts ---
# Transcript corpus is fetched by the ingestion pipeline, not committed.
data/corpus/
data/cache/
*.log

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
