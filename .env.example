# =============================================================================
# The Lenny Growth Assistant — environment configuration
#
# Copy to `.env` and adjust:   cp .env.example .env
# Every value below is a SAFE DEFAULT for local development.
# The app starts with zero edits if you are running the Docker Compose stack.
#
# NEVER commit a filled-in .env. It is listed in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — Database
# -----------------------------------------------------------------------------
# Postgres connection URL (asyncpg driver).
# docker compose  -> host is `postgres` (the service name)
# running locally -> host is `localhost`
DATABASE_URL=postgresql+asyncpg://lenny:lenny@localhost:5432/lenny

# -----------------------------------------------------------------------------
# REQUIRED — Model provider selection
# -----------------------------------------------------------------------------
# Which provider serves chat completions. Switch this value and restart;
# no application code changes. The UI shows the active provider.
#   ollama    -> local, no API key, MANDATORY for the graded demo
#   anthropic -> cloud, requires ANTHROPIC_API_KEY
MODEL_PROVIDER=ollama

# If the primary provider fails (down / timeout / missing key), fall back to
# this one. Set to `none` to disable fallback and surface the error instead.
MODEL_FALLBACK_PROVIDER=none

# -----------------------------------------------------------------------------
# REQUIRED for the demo — Ollama (local model)
# -----------------------------------------------------------------------------
# docker compose  -> http://ollama:11434
# running locally -> http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Chat model. `llama3.2` (3B) is the default and runs on CPU without a GPU.
#
# Speed reality check: on a CPU-only machine expect a few tokens per second,
# so a full answer takes 30-90s. If that is too slow for your demo, use
# `ollama pull llama3.2:1b` and set OLLAMA_MODEL=llama3.2:1b — roughly 3x
# faster with shorter, blunter answers. Quality/latency is a real trade-off
# here, not a defect.
OLLAMA_MODEL=llama3.2

# Embedding model used by ingestion AND query time. These must match:
# changing it invalidates the index, so re-run ingestion afterwards.
OLLAMA_EMBED_MODEL=nomic-embed-text

# Seconds before a local generation attempt is abandoned.
#
# CPU inference is slow: a chat answer takes 30-120s and a 1,250-word Ship 30
# essay several minutes. This ceiling is deliberately generous so a legitimate
# long generation completes rather than being cut off. Lower it if you would
# rather fail fast; raise it if you see provider_timeout on essays.
OLLAMA_TIMEOUT_SECONDS=600

# -----------------------------------------------------------------------------
# OPTIONAL — Anthropic (cloud model)
# -----------------------------------------------------------------------------
# Leave blank to run fully local. The app starts without it; the Anthropic
# provider reports itself unavailable rather than crashing at boot.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# OPTIONAL — Agent runner backend
# -----------------------------------------------------------------------------
# native           -> provider-agnostic runner; works with Ollama. Default.
# claude_agent_sdk -> official Anthropic Claude Agent SDK. Cloud only;
#                     requires ANTHROPIC_API_KEY and the Claude Code CLI.
# See architecture.md "Agent layer" for why both exist.
AGENT_RUNNER=native

# -----------------------------------------------------------------------------
# OPTIONAL — Retrieval tuning
# -----------------------------------------------------------------------------
# Candidates pulled from each retrieval arm (lexical + dense) before fusion.
RETRIEVAL_CANDIDATES=40

# Chunks handed to the model as grounding context after fusion + rerank.
RETRIEVAL_TOP_K=5

# Minimum cosine similarity (0-1) for the best retrieved passage to count as
# usable evidence. Below this — and with no exact-term match — the assistant
# declines instead of guessing.
#
# Calibrated against this corpus, not guessed: on-topic product/growth queries
# score 0.65-0.72, clearly off-topic ones 0.42-0.45. 0.55 sits in the gap.
# Raise it for stricter grounding; lower it if the assistant refuses too often.
RETRIEVAL_MIN_SIMILARITY=0.55

# -----------------------------------------------------------------------------
# OPTIONAL — Ingestion
# -----------------------------------------------------------------------------
INGEST_REPO_URL=https://github.com/ChatPRD/lennys-podcast-transcripts
INGEST_REPO_REF=main

# Episodes to ingest, in alphabetical order (deterministic, so two machines
# build the same index). Embedding runs locally on CPU at roughly 50 seconds
# per episode, so this is a real time/coverage trade-off:
#   --episodes 8   ~7 min   enough to demo grounding end to end
#   30 (default)   ~25 min  broad enough for most product/growth questions
#   --all          ~4 hrs   the full 269-episode archive
# Set to 0 (or pass --all) to ingest everything.
INGEST_MAX_EPISODES=30

# Target chunk size in words, and overlap carried between adjacent chunks so a
# thought split across a boundary is still retrievable.
INGEST_CHUNK_WORDS=320
INGEST_CHUNK_OVERLAP_WORDS=60

# Strip sponsor/ad-read segments from transcripts at ingestion time.
# The source transcripts inline host-read ads; indexing them causes the
# assistant to cite ad copy as product advice. See architecture.md.
INGEST_STRIP_SPONSORS=true

# -----------------------------------------------------------------------------
# OPTIONAL — Server & observability
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# json    -> structured one-line-per-event, for log aggregation
# console -> human-readable, for local development
LOG_FORMAT=console

API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
